{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pingstep",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "pingstep.dev", "custom_domain": true },
    { "pattern": "www.pingstep.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/app", "/status", "/index.html"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pingstep",
      "database_id": "7b97b545-381c-481c-a5fa-af549bdedd33",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://pingstep.dev"
  }
}
