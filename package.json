{
  "name": "pingstep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pingstep": "bin/pingstep.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --experimental-strip-types test/*.test.js test/*.test.ts",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/worker/service.ts' --test-coverage-include='src/worker/auth.ts' --test-coverage-include='src/worker/operator.ts' --test-coverage-include='src/worker/plans.ts' --test-coverage-include='src/worker/billing.ts' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=65 test/worker-core.test.ts",
    "test:e2e": "playwright test",
    "check:governance": "node --test test/governance.test.js",
    "hash-token": "node src/hash-token.js",
    "pilot-scorecard": "node bin/pilot-scorecard.js",
    "demo": "sh bin/demo-local.sh",
    "demo:gallery": "sh bin/demo-status-gallery.sh",
    "verify:late-run:staging": "node scripts/verify-late-run-staging.mjs",
    "e2e:staging:cleanup": "node scripts/e2e-staging-cleanup.mjs",
    "e2e:staging:janitor": "node scripts/e2e-staging-janitor.mjs",
    "e2e:staging:legacy-inventory": "node scripts/e2e-legacy-inventory.mjs",
    "worker:types": "wrangler types",
    "worker:check": "tsc --noEmit",
    "worker:dev": "wrangler dev --local",
    "worker:deploy:dry-run": "wrangler deploy --env='' --dry-run",
    "worker:deploy:staging:dry-run": "wrangler deploy --env staging --dry-run",
    "worker:deploy:staging": "wrangler deploy --env staging",
    "worker:deploy:production": "wrangler deploy --env=''"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
